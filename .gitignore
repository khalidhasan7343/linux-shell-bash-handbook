# Build output: only the finished handbook PDF is committed, so it can be
# downloaded straight from the repository. Anything else in build/ is ignored.
build/*
!build/linux-shell-bash-handbook.pdf

# Local archive of the original downloads (not part of the repo)
_originals/

# Python
__pycache__/
*.pyc

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
